# Copy to .env.local for local development. Never commit .env.local itself
# (already covered by .gitignore's `.env*` rule).

# ── Notion (required for live Notion data) ──────────────────────────────────
# Read-only integration token. Server/build-time only — NEVER prefix with
# NEXT_PUBLIC_, and never import @notionhq/client outside lib/notion-os.ts
# or lib/environmental/*. Without this, Notion-fed pages fall back to
# curated static content (see lib/notion-os.ts).
NOTION_API_KEY=

# ── Environmental observations (Rock Creek OS dashboard) ────────────────────
# No credential required. Open-Meteo's forecast and air-quality endpoints are
# keyless and public — see lib/environmental/open-meteo-adapter.ts. Listed
# here only so the ingestion path is documented alongside everything else;
# there is nothing to set.
#
# To fetch one observation locally:
#   node --experimental-strip-types scripts/ingest-environmental-observation.mts
